local D = require("./DistrictRules")
local passed, seq = 0, 0
local function test(name, fn)
	local ok, err = pcall(fn); if not ok then error(name .. ": " .. tostring(err)) end
	passed += 1; print("PASS", name)
end
local function apply(s, op)
	seq += 1; op.id = op.id or tostring(seq)
	-- Test adapter captures server session/detention metadata at event creation.
	if op.session == nil and s.actors[op.actor] then op.session = s.actors[op.actor].session end
	if op.targetSession == nil and s.actors[op.target] then op.targetSession = s.actors[op.target].session end
	if op.kind == "EscapeStep" and s.actors[op.target] and s.actors[op.target].jail then
		op.jailId = op.jailId or s.actors[op.target].jail.id
		op.revision = op.revision or s.actors[op.target].jail.revision
	end
	return D.apply(s, op)
end
local function join(s, name) return apply(s, {kind="Join", actor=name}) end
local function arrest(s, target, npc, cop)
	s = apply(s, {kind="Heat",actor=target,delta=2})
	return apply(s,{kind="Arrest",actor=cop,target=target,npc=npc,evidence={lineOfSight=true,stunned=true,distance=4}})
end
test("ten fallback police only while no human cops",function()
	local s=join(D.new(0),"cop"); assert(s.npcs==10)
	s=apply(s,{kind="Faction",actor="cop",faction="Police"}); assert(s.npcs==0)
	s=apply(s,{kind="Leave",actor="cop"}); assert(s.npcs==10)
	s=join(s,"cop"); assert(s.npcs==0)
end)
test("solo can escape harder NPC confinement sequentially",function()
	local s=join(D.new(0),"solo"); s=arrest(s,"solo",true)
	assert(s.actors.solo.jail.needed==3)
	for i=1,3 do s=apply(s,{kind="EscapeStep",actor="solo",target="solo",step=i,evidence={channelComplete=true,inRange=true}}) end
	assert(s.actors.solo.jail==nil and s.actors.solo.heat==1)
end)
test("human arrest requires counterplay and shorter solo escape",function()
	local s=join(join(D.new(0),"thief"),"cop")
	s=apply(s,{kind="Faction",actor="cop",faction="Police"})
	s=arrest(s,"thief",false,"cop"); assert(s.actors.thief.jail.needed==2)
	local ok=pcall(apply,s,{kind="EscapeStep",actor="thief",target="thief",step=2,evidence={channelComplete=true,inRange=true}})
	assert(not ok and s.actors.thief.jail.steps[2]==nil)
end)
test("joining cop does not erase existing NPC prison challenge",function()
	local s=join(join(D.new(0),"thief"),"cop"); s=arrest(s,"thief",true)
	s=apply(s,{kind="Faction",actor="cop",faction="Police"})
	assert(s.npcs==0 and s.actors.thief.jail.origin=="NPC" and s.actors.thief.jail.needed==3)
end)
test("crews cap at five and helper must be teammate",function()
	local s=D.new(0)
	for i=1,6 do s=join(s,tostring(i)) end
	for i=1,5 do s=apply(s,{kind="Crew",actor=tostring(i),crew="A"}) end
	assert(not pcall(apply,s,{kind="Crew",actor="6",crew="A"}))
	s=arrest(s,"1",true)
	assert(not pcall(apply,s,{kind="EscapeStep",actor="6",target="1",step=1,evidence={channelComplete=true,inRange=true}}))
	s=apply(s,{kind="EscapeStep",actor="2",target="1",step=1,evidence={channelComplete=true,inRange=true}})
	assert(s.actors["1"].jail.steps[1])
end)
test("blackout expires even if instigator disconnects and cannot chain",function()
	local s=join(D.new(0),"a")
	local op={id="blackout-a",kind="Blackout",actor="a",evidence={channelComplete=true,atGrid=true}}
	s=apply(s,op); assert(not s.circuits.cameras and s.circuits.auxiliaryObjective)
	local again,changed=D.apply(s,op); assert(not changed and again.blackout.untilTime==90)
	assert(not pcall(apply,s,{kind="Blackout",actor="a",evidence={channelComplete=true,atGrid=true}}))
	s=apply(s,{kind="Leave",actor="a"}); s=D.tick(s,91)
	assert(s.circuits.windows and s.circuits.poweredDoors and not s.circuits.auxiliaryObjective)
end)
test("vehicle recognition expires and cannot be evaded by faction switch",function()
	local s=join(D.new(0),"a")
	s=apply(s,{kind="Heat",actor="a",delta=2,vehicle="earned-car-1"})
	assert(D.vehicleRecognized(s,"a","earned-car-1"))
	assert(not pcall(apply,s,{kind="Faction",actor="a",faction="Police"}))
	s=D.tick(s,181); assert(not D.vehicleRecognized(s,"a","earned-car-1"))
end)
test("decoys never hold real loot or mint currency",function()
	local s=join(D.new(0),"a")
	s=apply(s,{kind="Decoy",actor="a",decoy="fake1",appearance="Bag"})
	assert(s.decoys.fake1.fake and s.decoys.fake1.lootId==nil and s.decoys.fake1.value==nil)
end)
test("convoy claim unique and stale intercept rejected",function()
	local s=join(D.new(0),"a")
	s=apply(s,{kind="ConvoySpawn",convoy="van1",lootId="loot-real1"})
	s=apply(s,{kind="ConvoyAdvance",convoy="van1",revision=1})
	assert(not pcall(apply,s,{kind="ConvoyIntercept",convoy="van1",actor="a",revision=1,evidence={inRange=true,channelComplete=true}}))
	s=apply(s,{kind="ConvoyIntercept",convoy="van1",actor="a",revision=2,evidence={inRange=true,channelComplete=true}})
	s=apply(s,{kind="ConvoyClaim",convoy="van1",actor="a",revision=3,evidence={inRange=true,channelComplete=true}})
	assert(s.convoys.van1.claimedBy=="a")
	assert(not pcall(apply,s,{kind="ConvoyClaim",convoy="van1",actor="a",revision=3,evidence={inRange=true,channelComplete=true}}))
	assert(not pcall(apply,s,{kind="ConvoySpawn",convoy="van2",lootId="loot-real1"}))
end)
test("leader disconnect elects online member and reconnect does not steal leadership",function()
	local s=join(join(join(D.new(0),"zack"),"beth"),"anna")
	for _,name in ipairs({"zack","beth","anna"}) do s=apply(s,{kind="Crew",actor=name,crew="A"}) end
	assert(s.crews.A.leader=="zack")
	s=apply(s,{kind="Leave",actor="zack"}); assert(s.crews.A.leader=="anna")
	assert(s.crews.A.members.zack and s.actors.zack.crew=="A")
	s=join(s,"zack"); assert(s.crews.A.leader=="anna")
	assert(s.actors.zack.session==2)
	for _,name in ipairs({"anna","beth","zack"}) do s=apply(s,{kind="Leave",actor=name}) end
	assert(s.crews.A.leader==nil)
	s=join(s,"beth"); assert(s.crews.A.leader=="beth")
end)
test("leader crew change and police switch repair both membership directions",function()
	local s=join(join(D.new(0),"a"),"b")
	s=apply(s,{kind="Crew",actor="a",crew="A"}); s=apply(s,{kind="Crew",actor="b",crew="A"})
	s=apply(s,{kind="Crew",actor="a",crew="B"})
	assert(s.crews.A.leader=="b" and not s.crews.A.members.a and s.actors.a.crew=="B")
	assert(s.crews.B.leader=="a")
	s=apply(s,{kind="Faction",actor="a",faction="Police"})
	assert(s.crews.B==nil and s.actors.a.crew==nil and s.humanCops==1 and s.npcs==0)
	assert(not pcall(apply,s,{kind="Crew",actor="a",crew="A"}))
	s=apply(s,{kind="Faction",actor="a",faction="Crew"})
	assert(s.actors.a.crew==nil and s.npcs==10 and s.crews.A.leader=="b")
end)
test("failed move to a full crew preserves old membership and leader",function()
	local s=D.new(0)
	for i=1,6 do s=join(s,tostring(i)) end
	for i=1,5 do s=apply(s,{kind="Crew",actor=tostring(i),crew="A"}) end
	s=apply(s,{kind="Crew",actor="6",crew="B"})
	assert(not pcall(apply,s,{kind="Crew",actor="6",crew="A"}))
	assert(s.actors["6"].crew=="B" and s.crews.B.members["6"] and s.crews.B.leader=="6")
end)
test("leave-rejoin preserves custody and rejects old session actions",function()
	local s=join(D.new(0),"solo"); s=arrest(s,"solo",true)
	local jailId=s.actors.solo.jail.id; local session=s.actors.solo.session
	s=apply(s,{kind="Leave",actor="solo"})
	assert(not pcall(apply,s,{kind="EscapeStep",actor="solo",target="solo",step=1,evidence={inRange=true,channelComplete=true}}))
	s=join(s,"solo"); assert(s.actors.solo.jail.id==jailId and s.actors.solo.session==session+1)
	assert(not pcall(apply,s,{kind="Leave",actor="solo",session=session}))
	assert(not pcall(apply,s,{kind="EscapeStep",actor="solo",target="solo",session=session,step=1,evidence={inRange=true,channelComplete=true}}))
	s=apply(s,{kind="EscapeStep",actor="solo",target="solo",step=1,evidence={inRange=true,channelComplete=true}})
	assert(s.actors.solo.jail.steps[1])
end)
test("escape progress rejects stale revisions and previous detention IDs",function()
	local s=join(D.new(0),"solo"); s=arrest(s,"solo",true)
	local previousId=s.actors.solo.jail.id
	s=apply(s,{kind="EscapeStep",actor="solo",target="solo",step=1,evidence={inRange=true,channelComplete=true}})
	assert(not pcall(apply,s,{kind="EscapeStep",actor="solo",target="solo",step=2,revision=1,evidence={inRange=true,channelComplete=true}}))
	assert(not pcall(apply,s,{kind="EscapeStep",actor="solo",target="solo",step=1,evidence={inRange=true,channelComplete=true}}))
	assert(s.actors.solo.jail.revision==2)
	for step=2,3 do s=apply(s,{kind="EscapeStep",actor="solo",target="solo",step=step,evidence={inRange=true,channelComplete=true}}) end
	s=arrest(s,"solo",true); assert(s.actors.solo.jail.id~=previousId)
	assert(not pcall(apply,s,{kind="EscapeStep",actor="solo",target="solo",jailId=previousId,revision=1,step=1,evidence={inRange=true,channelComplete=true}}))
	assert(s.actors.solo.jail.steps[1]==nil)
end)
test("offline, detained, faction-switched and former crew helpers cannot progress jail",function()
	local s=join(join(join(D.new(0),"prisoner"),"helper"),"cop")
	for _,name in ipairs({"prisoner","helper"}) do s=apply(s,{kind="Crew",actor=name,crew="A"}) end
	s=arrest(s,"prisoner",true)
	s=apply(s,{kind="Leave",actor="helper"})
	local function help() return apply(s,{kind="EscapeStep",actor="helper",target="prisoner",step=1,evidence={inRange=true,channelComplete=true}}) end
	assert(not pcall(help)); s=join(s,"helper")
	s=arrest(s,"helper",true); assert(not pcall(help))
	for step=1,3 do s=apply(s,{kind="EscapeStep",actor="helper",target="helper",step=step,evidence={inRange=true,channelComplete=true}}) end
	s=apply(s,{kind="Heat",actor="helper",delta=-5})
	s=apply(s,{kind="Faction",actor="helper",faction="Police"}); assert(not pcall(help))
	s=apply(s,{kind="Faction",actor="helper",faction="Crew"})
	s=apply(s,{kind="Crew",actor="helper",crew="B"}); assert(not pcall(help))
	s=apply(s,{kind="Crew",actor="helper",crew="A"}); s=help()
	assert(s.actors.prisoner.jail.steps[1])
end)
test("same operation ID is exact replay only and stored payload is independent",function()
	local s=join(D.new(0),"a")
	local op={id="stable-heat",kind="Heat",actor="a",delta=1}
	s=apply(s,op); local replay,changed=D.apply(s,op)
	assert(replay==s and not changed and s.actors.a.heat==1)
	op.delta=2
	assert(not pcall(D.apply,s,op)); assert(s.actors.a.heat==1 and s.applied[op.id].delta==1)
	assert(not pcall(D.apply,s,{id="stable-heat",kind="Leave",actor="a",session=1}))
end)
test("strict evidence rejects truthy substitutes without changing world",function()
	local s=join(D.new(0),"a")
	assert(not pcall(apply,s,{kind="Blackout",actor="a",evidence={channelComplete="false",atGrid=1}}))
	assert(s.circuits.cameras and s.blackout.untilTime==0)
	s=arrest(s,"a",true)
	assert(not pcall(apply,s,{kind="EscapeStep",actor="a",target="a",step=1,evidence={channelComplete="true",inRange=true}}))
	assert(s.actors.a.jail.steps[1]==nil)
end)
test("convoy claim rejects stale revision, stale actor session, and rival duplicate",function()
	local s=join(join(D.new(0),"a"),"b")
	s=apply(s,{kind="ConvoySpawn",convoy="van",lootId="real"})
	s=apply(s,{kind="ConvoyIntercept",convoy="van",actor="a",revision=1,evidence={inRange=true,channelComplete=true}})
	assert(not pcall(apply,s,{kind="ConvoyClaim",convoy="van",actor="a",revision=1,evidence={inRange=true,channelComplete=true}}))
	local session=s.actors.a.session
	s=apply(s,{kind="Leave",actor="a"}); s=join(s,"a")
	assert(not pcall(apply,s,{kind="ConvoyClaim",convoy="van",actor="a",session=session,revision=2,evidence={inRange=true,channelComplete=true}}))
	assert(not pcall(apply,s,{kind="ConvoyClaim",convoy="van",actor="b",revision=2,evidence={inRange="true",channelComplete=true}}))
	s=apply(s,{kind="ConvoyClaim",convoy="van",actor="b",revision=2,evidence={inRange=true,channelComplete=true}})
	assert(s.convoys.van.claimedBy=="b")
	assert(not pcall(apply,s,{kind="ConvoyClaim",convoy="van",actor="a",revision=2,evidence={inRange=true,channelComplete=true}}))
end)
test("arrest rejects previous target session and truthy NPC origin",function()
	local s=join(D.new(0),"a"); s=apply(s,{kind="Heat",actor="a",delta=1})
	local session=s.actors.a.session
	s=apply(s,{kind="Leave",actor="a"}); s=join(s,"a")
	assert(not pcall(apply,s,{kind="Arrest",target="a",targetSession=session,npc=true,evidence={lineOfSight=true,stunned=true,distance=4}}))
	assert(not pcall(apply,s,{kind="Arrest",target="a",npc="true",evidence={lineOfSight=true,stunned=true,distance=4}}))
	assert(s.actors.a.jail==nil and s.actors.a.heat==1)
end)
