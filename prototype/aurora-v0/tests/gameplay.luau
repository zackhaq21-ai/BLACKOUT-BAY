local Rules = require("../src/shared/Rules")
local Model = require("../src/server/ProfileModel")
local Config = require("../src/shared/Config")
local passed = 0
local function test(name, fn)
	local ok, err = pcall(fn)
	if not ok then error("FAIL " .. name .. ": " .. tostring(err), 0) end
	passed += 1; print("PASS", name)
end
local function make(n, seed)
	local ids = {}; for i = 1, n do ids[i] = i end
	return Rules.new(ids, seed or 100, "Shuffle", 20000)
end
local function enter(s)
	for id in pairs(s.members) do assert(Rules.enter(s, id, "Exhibit")) end
end
local function quiet(s, id)
	for i = 1, s.needed do assert(Rules.signal(s, id, i)) end
	assert(Rules.power(s, id)); assert(Rules.vault(s, id, false)); assert(Rules.takeCore(s, id))
end

for count = 1, 5 do
	test(count .. " player quiet mission sequentially completable by one member", function()
		local s = make(count); enter(s); quiet(s, 1)
		assert(Rules.curator(s, 1, "Release"))
		local near = {}; for i = 1, count do near[i] = true end
		assert(Rules.extract(s, 1, "Canal", near))
		assert(s.status == "Success" and s.escapedCount == count)
		assert(Rules.reward(s, 1) >= 125)
	end)
	test(count .. " player force-vault fallback needs no simultaneous partners", function()
		local s = make(count); enter(s)
		assert(Rules.vault(s, 1, true)); assert(Rules.takeCore(s, 1))
		Rules.addHeat(s, 100)
		assert(not Rules.canExit(s, "Tram")); assert(Rules.canExit(s, "Tunnel"))
		assert(s.timeLeft == 60); assert(Rules.extract(s, 1, "Tunnel", {[1] = true}))
	end)
end
test("invalid crew sizes and duplicate IDs rejected", function()
	assert(not pcall(Rules.new, {}, 1, "Daily", 1))
	assert(not pcall(Rules.new, {1,2,3,4,5,6}, 1, "Daily", 1))
	assert(not pcall(Rules.new, {1,1}, 1, "Daily", 1))
end)
test("daily seed deterministic but shuffle has distinct configurations", function()
	local seen = {}
	for seed = 1, 50 do
		local a, b = make(1, seed), make(1, seed)
		assert(a.vault == b.vault and a.watchedEntrance == b.watchedEntrance and a.patrolOffset == b.patrolOffset)
		seen[a.vault .. a.watchedEntrance .. a.patrolOffset] = true
	end
	local count = 0; for _ in pairs(seen) do count += 1 end
	assert(count >= 9)
end)
test("quiet vault cannot open before both requirements", function()
	local s = make(1); enter(s)
	assert(not Rules.vault(s, 1, false))
	assert(Rules.signal(s, 1, 1)); assert(Rules.signal(s, 1, 2))
	assert(not Rules.vault(s, 1, false)); assert(Rules.power(s, 1))
	assert(Rules.vault(s, 1, false)); assert(not Rules.vault(s, 1, false))
end)
test("spectator and pre-entry actions rejected", function()
	local s = make(1)
	assert(not Rules.signal(s, 1, 1)); assert(not Rules.power(s, 1))
	assert(not Rules.vault(s, 99, true)); assert(not Rules.enter(s, 99, "Service"))
	assert(not Rules.enter(s, 1, "InventedRoute")); assert(not Rules.extract(s, 99, "Tunnel", {}))
end)
test("unique signals and core prevent duplicate objective credit", function()
	local s = make(2); enter(s)
	assert(Rules.signal(s, 1, 1)); assert(not Rules.signal(s, 2, 1))
	assert(not Rules.signal(s, 1, 0)); assert(not Rules.signal(s, 1, 1.5))
	assert(Rules.vault(s, 1, true)); assert(Rules.takeCore(s, 1)); assert(not Rules.takeCore(s, 2))
end)
test("capture consequence, free solo recovery and core recovery", function()
	local s = make(1); enter(s); quiet(s, 1); s.members[1].bonus = 3
	assert(Rules.capture(s, 1)); assert(s.core == "Dropped" and not s.carrier)
	assert(s.members[1].bonus == 0); assert(not Rules.takeCore(s, 1))
	assert(Rules.recover(s, 1)); assert(s.timeLeft == 465)
	assert(Rules.enter(s, 1, "Service")); assert(Rules.takeCore(s, 1))
	assert(Rules.extract(s, 1, "Tunnel", {[1] = true}))
end)
test("disconnect carrier drops core and reassigns roles", function()
	local s = make(5); enter(s); quiet(s, 1)
	assert(Rules.remove(s, 1)); assert(s.core == "Dropped")
	assert(s.members[2].role == "Coordinator"); assert(s.needed == 3)
	assert(Rules.takeCore(s, 2)); assert(Rules.extract(s, 2, "Tunnel", {[2] = true}))
end)
test("crew reduces 5 to 1 without impossible objective or role lock", function()
	local s = make(5); enter(s); assert(s.needed == 4)
	for i = 2, 5 do Rules.remove(s, i) end
	assert(s.needed == 2 and s.members[1].role == "Solo / all tools")
	quiet(s, 1); assert(Rules.extract(s, 1, "Tunnel", {[1] = true}))
end)
test("all disconnects end abandoned run", function()
	local s = make(1); Rules.remove(s, 1)
	assert(s.status == "Failed")
end)
test("curator decision branches have lasting consequences", function()
	local s = make(1); enter(s); local heat = s.heat
	assert(Rules.curator(s, 1, "Capture")); assert(s.signalCount == 1 and s.heat == heat + 25)
	assert(not Rules.curator(s, 1, "Capture")); assert(not Rules.canExit(s, "Canal"))
	assert(Rules.curator(s, 1, "Release")); assert(Rules.canExit(s, "Canal"))
	assert(not Rules.curator(s, 1, "Capture"))
end)
test("only carrier extracts and only nearby crew gets full reward", function()
	local s = make(2); enter(s); quiet(s, 1)
	assert(not Rules.extract(s, 2, "Tunnel", {[2] = true}))
	assert(Rules.extract(s, 1, "Tunnel", {[1] = true}))
	assert(Rules.reward(s, 1) >= 100 and Rules.reward(s, 2) == 25)
	assert(not Rules.extract(s, 1, "Tunnel", {[1] = true}))
end)
test("timeout fails and new retry has clean mission state", function()
	local s = make(1); enter(s); Rules.tick(s, 481)
	assert(s.status == "Failed" and s.timeLeft == 0 and Rules.reward(s, 1) == 25)
	assert(not Rules.signal(s, 1, 1)); assert(not Rules.vault(s, 1, true))
	local retry = make(1); assert(retry.status == "Active" and retry.heat == 0 and retry.members[1].stasis == 3)
end)
test("lockdown starts only once and cannot extend time", function()
	local s = make(1); Rules.addHeat(s, 100); assert(s.timeLeft == 60)
	Rules.tick(s, 20); Rules.addHeat(s, -20); Rules.addHeat(s, 20); assert(s.timeLeft == 40)
end)
test("receipt replay grants permanent cosmetic exactly once", function()
	local op = {kind = "Receipt", receipt = "receipt-1", item = "prism"}
	local p = Model.apply(nil, op, Config.Catalog); local again = Model.apply(p, op, Config.Catalog)
	assert(again.entitlements.prism and again.receipts["receipt-1"] and again.xp == 0)
	local count = 0; for _ in pairs(again.receipts) do count += 1 end; assert(count == 1)
end)
test("run reward idempotent and merged with existing purchased entitlement", function()
	local p = Model.apply(nil, {kind = "Receipt", receipt = "receipt-2", item = "prism"}, Config.Catalog)
	local op = {kind = "Run", id = "run-a", xp = 250, won = true}
	p = Model.apply(p, op, Config.Catalog); p = Model.apply(p, op, Config.Catalog)
	assert(p.xp == 250 and p.runs == 1 and p.wins == 1 and p.entitlements.prism and p.entitlements.amber)
end)
test("lost heist never removes owned paid cosmetic", function()
	local p = Model.apply(nil, {kind = "Receipt", receipt = "receipt-3", item = "auroraplant"}, Config.Catalog)
	p = Model.apply(p, {kind = "Run", id = "failure", xp = 25, won = false}, Config.Catalog)
	assert(p.entitlements.auroraplant and p.wins == 0)
end)
test("equipping requires owned catalog item and does not modify stats", function()
	local p = Model.apply(nil, {kind = "Equip", item = "prism"}, Config.Catalog)
	assert(p.equipped == "mint" and p.xp == 0)
	p = Model.apply(p, {kind = "Run", id = "run", xp = 400, won = true}, Config.Catalog)
	p = Model.apply(p, {kind = "Equip", item = "amber"}, Config.Catalog)
	assert(p.equipped == "amber" and p.xp == 400)
	p = Model.apply(p, {kind = "Equip", item = "moonlamp"}, Config.Catalog); assert(p.decor == "moonlamp")
end)
test("unknown save schemas cannot be replaced by defaults", function()
	assert(not pcall(Model.clean, {version = 2, xp = 9000}))
	assert(not pcall(Model.clean, "corrupt"))
	local p = Model.clean({version = 1, xp = 0/0}); assert(p.xp == 0)
end)
test("all purchase and production-save switches disabled", function()
	assert(Config.MaxPlayers == 5 and not Config.CommerceEnabled and not Config.DataStoreEnabled)
	for _, item in ipairs(Config.Catalog) do assert(item.PassId == 0 and item.ProductId == 0) end
end)
print("RESULT", passed, "tests passed; pure Luau logic only, not a Roblox engine playtest.")
