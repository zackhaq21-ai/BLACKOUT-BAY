local HR = require("../src/shared/Core/HideoutRecord")

return function(t)
	t.test("migrate tolerates garbage and clamps", function()
		local r = HR.migrate(nil); t.eq(r.stash, 0); t.eq(r.tier, 0)
		local r2 = HR.migrate({ stash = 12.7, tier = 99, reports = { { t = 1 } }, unread = 1 })
		t.eq(r2.stash, 12); t.eq(r2.tier, 6); t.eq(#r2.reports, 1); t.eq(r2.unread, 1)
	end)
	t.test("deposit, upgrade, bank with cooldown", function()
		local r = HR.default()
		t.truthy((HR.deposit(r, 5000))); t.falsy((HR.deposit(r, -1))); t.falsy((HR.deposit(r, 1.5)))
		t.truthy((HR.upgrade(r, 1500, 6, 100))); t.eq(r.tier, 1); t.eq(r.stash, 3500)
		local ok, err = HR.upgrade(r, 9999, 6, 100); t.falsy(ok); t.eq(err, "not enough in the stash")
		t.falsy((HR.upgrade(r, 1, 1, 100)), "max tier")
		t.truthy((HR.bank(r, 1000, 120, 200))); t.eq(r.stash, 2500)
		local ok2, err2 = HR.bank(r, 100, 120, 250); t.falsy(ok2); t.truthy(err2:find("cooling"))
		t.falsy((HR.bank(r, 99999, 120, 400)), "over stash")
	end)
	t.test("raid lock is exclusive across servers and attackers, expires, and respects cooldown", function()
		local r = HR.default(); HR.deposit(r, 20000)
		t.truthy((HR.claimRaid(r, "srvA", "alice", "Alice", 1000, 420, 600)))
		local ok, err = HR.claimRaid(r, "srvB", "bob", "Bob", 1001, 420, 600); t.falsy(ok); t.eq(err, "already being raided")
		t.falsy((HR.upgrade(r, 1500, 6, 1002)), "owner cannot upgrade mid-raid")
		t.falsy((HR.bank(r, 100, 0, 1002)), "owner cannot bank mid-raid")
		t.truthy((HR.deposit(r, 10)), "deposits still allowed")
		-- wrong holder cannot crack
		local _, stolen = HR.crack(r, "srvB", "bob", function(s) return math.floor(s * 0.5) end, 1003); t.eq(stolen, 0)
		local r2, stolen2 = HR.crack(r, "srvA", "alice", function(s) return s end, 1003)
		t.truthy(r2); t.eq(stolen2, 20010); t.eq(r.stash, 0); t.eq(r.lifetimeLost, 20010)
		-- retained bags flow back, but the same raid can never crack twice
		HR.retain(r, 2500)
		local r3, stolen3 = HR.crack(r, "srvA", "alice", function(s) return s end, 1004)
		t.falsy(r3); t.eq(stolen3, 0); t.eq(r.stash, 2500)
		-- bob cannot release alice's lock while it is live
		t.falsy((HR.releaseRaid(r, "srvB", "bob", nil, 10, 1004)))
		t.truthy((HR.releaseRaid(r, "srvA", "alice", { t = 1004, raider = "alice", raiderName = "Alice", crewNames = {}, entry = "breaker", defences = {}, lost = 17510, retained = 2500 }, 10, 1004)))
		t.eq(r.raid, nil); t.eq(r.unread, 1); t.eq(#r.reports, 1)
		local ok3, err3 = HR.claimRaid(r, "srvB", "bob", "Bob", 1100, 420, 600); t.falsy(ok3); t.truthy(err3:find("recently"))
		t.truthy((HR.claimRaid(r, "srvB", "bob", "Bob", 1700, 420, 600)))
		-- expired lock can be taken over by anyone
		t.truthy((HR.claimRaid(r, "srvC", "carol", "Carol", 1700 + 421, 420, 0)))
		t.eq(r.raid.raider, "carol")
		t.truthy((HR.releaseRaid(r, "srvZ", "zed", nil, 10, 1700 + 421 + 500)), "expired lock releasable by anyone")
	end)
	t.test("recovery: window, bounded by lost, one claim chain per raid, same value moves", function()
		local victim = HR.default(); HR.deposit(victim, 5000)
		local raider = HR.default()
		-- the theft
		HR.claimRaid(victim, "s", "bob", "Bob", 100, 420, 0)
		local _, stolen = HR.crack(victim, "s", "bob", function(st) return st end, 101)
		t.eq(stolen, 5000)
		HR.releaseRaid(victim, "s", "bob", { t = 102, raidId = "raid1", raider = "bob", raiderName = "Bob", crewNames = {}, entry = "x", defences = {}, lost = 5000, retained = 0, recoveryUntil = 102 + 1200, recoveryRaider = "bob" }, 10, 102)
		HR.deposit(raider, 5000) -- bob delivered the bundles
		t.eq(HR.recoverable(victim, "raid1", 200), 5000)
		t.eq(HR.recoverable(victim, "raid1", 102 + 1200), 0, "window closed")
		t.eq(HR.recoverable(victim, "nope", 200), 0)
		-- clues
		t.truthy(HR.addClue(victim, "raid1", { t = 103, text = "picked up near Harbour Piers" }, 2))
		HR.addClue(victim, "raid1", { t = 104, text = "stowed" }, 2); HR.addClue(victim, "raid1", { t = 105, text = "delivered" }, 2)
		t.eq(#HR.reportFor(victim, "raid1").clues, 2); t.eq(HR.reportFor(victim, "raid1").clues[1].text, "stowed")
		-- physical intercept credits the victim, bounded by lost
		local _, credited = HR.noteRecovered(victim, "raid1", 1000); t.eq(credited, 1000)
		t.eq(HR.recoverable(victim, "raid1", 200), 4000)
		-- recovery mission on bob's record: needs the lock, takes min(remaining, stash), once
		t.falsy((HR.recover(raider, "s", "alice", "raid1", 4000, 300)), "no lock")
		HR.claimRaid(raider, "s", "alice", "Alice", 300, 420, 0)
		local r2, got = HR.recover(raider, "s", "alice", "raid1", 4000, 301)
		t.truthy(r2); t.eq(got, 4000); t.eq(raider.stash, 1000); t.eq(raider.recoveries.raid1, 4000)
		local _, again = HR.recover(raider, "s", "alice", "raid1", 4000, 302); t.eq(again, 0, "second crack in the same raid rejected")
		HR.releaseRaid(raider, "s", "alice", nil, 10, 302); HR.deposit(raider, 9000); HR.claimRaid(raider, "s", "alice", "Alice", 1000, 420, 0)
		local _, twice = HR.recover(raider, "s", "alice", "raid1", 4000, 1001); t.eq(twice, 0, "a later mission cannot debit the same raid again")
		HR.releaseRaid(raider, "s", "alice", nil, 10, 1002); HR.claimRaid(raider, "s", "alice", "Alice", 1700, 420, 0)
		HR.releaseRaid(raider, "s", "alice", { t = 303, raidId = "rec1", raider = "alice", raiderName = "Alice", crewNames = {}, entry = "recovery", defences = {}, lost = 4000, retained = 0, recovery = true }, 10, 303)
		local _, credited2 = HR.noteRecovered(victim, "raid1", 4000); t.eq(credited2, 4000)
		t.eq(HR.recoverable(victim, "raid1", 400), 0, "fully recovered: nothing left to claim")
		local _, over = HR.noteRecovered(victim, "raid1", 50); t.eq(over, 0)
		-- a stash smaller than the remaining debt yields only what exists
		local poor = HR.default(); HR.deposit(poor, 300); HR.claimRaid(poor, "s", "v", "V", 500, 420, 0)
		local _, part = HR.recover(poor, "s", "v", "raid9", 2000, 501); t.eq(part, 300); t.eq(poor.stash, 0)
	end)

	t.test("provisional report keeps clues and is finalized in place", function()
		local r = HR.default(); HR.deposit(r, 100)
		HR.claimRaid(r, "s", "bob", "Bob", 10, 420, 0)
		HR.openReport(r, { t = 10, raidId = "raidX", raider = "bob", raiderName = "Bob", crewNames = {}, entry = "in progress", defences = {}, lost = 0, retained = 0 }, 10)
		HR.openReport(r, { t = 10, raidId = "raidX", raider = "bob", raiderName = "Bob", crewNames = {}, entry = "dup", defences = {}, lost = 0, retained = 0 }, 10)
		t.eq(#r.reports, 1); t.eq(r.unread, 0)
		HR.addClue(r, "raidX", { t = 11, text = "picked up" }, 12)
		HR.releaseRaid(r, "s", "bob", { t = 20, raidId = "raidX", raider = "bob", raiderName = "Bob", crewNames = {}, entry = "pier door", defences = { "alarm" }, lost = 100, retained = 0, recoveryUntil = 1220 }, 10, 20)
		t.eq(#r.reports, 1); t.eq(r.unread, 1); t.eq(r.reports[1].entry, "pier door"); t.eq(r.reports[1].lost, 100)
		t.eq(#r.reports[1].clues, 1, "clues survive finalization")
		t.eq(HR.recoverable(r, "raidX", 100), 100)
	end)

	t.test("spend from the stash: bounds and raid lock", function()
		local r = HR.default(); HR.deposit(r, 300)
		t.truthy((HR.spend(r, 150, 0))); t.eq(r.stash, 150)
		local ok, err = HR.spend(r, 151, 0); t.falsy(ok); t.eq(err, "not enough in the stash")
		t.falsy((HR.spend(r, 0, 0))); t.falsy((HR.spend(r, 1.5, 0)))
		HR.claimRaid(r, "s", "x", "X", 10, 420, 0)
		local ok2, err2 = HR.spend(r, 10, 11); t.falsy(ok2); t.eq(err2, "raid in progress")
	end)

	t.test("owner name is stored and migrated", function()
		local r = HR.default(); HR.setName(r, "Zed")
		t.eq(HR.migrate(r).ownerName, "Zed"); t.eq(HR.migrate({ ownerName = 5 }).ownerName, nil)
	end)

	t.test("retain adds back and reports are capped", function()
		local r = HR.default()
		t.truthy((HR.retain(r, 300))); t.eq(r.stash, 300); t.falsy((HR.retain(r, 0)))
		for i = 1, 12 do
			HR.claimRaid(r, "s", "a", "A", i * 1000, 10, 0)
			HR.releaseRaid(r, "s", "a", { t = i, raider = "a", raiderName = "A", crewNames = {}, entry = "x", defences = {}, lost = 0, retained = 0 }, 10, i * 1000 + 1)
		end
		t.eq(#r.reports, 10); t.eq(r.reports[1].t, 12); t.eq(r.unread, 12)
		HR.markRead(r); t.eq(r.unread, 0)
	end)
end
