local HR = require("../src/shared/Core/HideoutRecord")

return function(t)
	t.test("migrate tolerates garbage and clamps", function()
		local r = HR.migrate(nil); t.eq(r.stash, 0); t.eq(r.tier, 0)
		local r2 = HR.migrate({ stash = 12.7, tier = 99, reports = { { t = 1 } }, unread = 1 })
		t.eq(r2.stash, 12); t.eq(r2.tier, 6); t.eq(#r2.reports, 1); t.eq(r2.unread, 1)
	end)
	t.test("deposit, upgrade, bank with cooldown", function()
		local r = HR.default()
		t.truthy((HR.deposit(r, 5000))); t.falsy((HR.deposit(r, -1))); t.falsy((HR.deposit(r, 1.5)))
		t.truthy((HR.upgrade(r, 1500, 6, 100))); t.eq(r.tier, 1); t.eq(r.stash, 3500)
		local ok, err = HR.upgrade(r, 9999, 6, 100); t.falsy(ok); t.eq(err, "not enough in the stash")
		t.falsy((HR.upgrade(r, 1, 1, 100)), "max tier")
		t.truthy((HR.bank(r, 1000, 120, 200))); t.eq(r.stash, 2500)
		local ok2, err2 = HR.bank(r, 100, 120, 250); t.falsy(ok2); t.truthy(err2:find("cooling"))
		t.falsy((HR.bank(r, 99999, 120, 400)), "over stash")
	end)
	t.test("raid lock is exclusive across servers and attackers, expires, and respects cooldown", function()
		local r = HR.default(); HR.deposit(r, 20000)
		t.truthy((HR.claimRaid(r, "srvA", "alice", "Alice", 1000, 420, 600)))
		local ok, err = HR.claimRaid(r, "srvB", "bob", "Bob", 1001, 420, 600); t.falsy(ok); t.eq(err, "already being raided")
		t.falsy((HR.upgrade(r, 1500, 6, 1002)), "owner cannot upgrade mid-raid")
		t.falsy((HR.bank(r, 100, 0, 1002)), "owner cannot bank mid-raid")
		t.truthy((HR.deposit(r, 10)), "deposits still allowed")
		-- wrong holder cannot crack
		local _, stolen = HR.crack(r, "srvB", "bob", function(s) return math.floor(s * 0.5) end, 1003); t.eq(stolen, 0)
		local r2, stolen2 = HR.crack(r, "srvA", "alice", function(s) return math.floor((s - 1000) * 0.35) end, 1003)
		t.truthy(r2); t.eq(stolen2, 6653); t.eq(r.stash, 20010 - 6653); t.eq(r.lifetimeLost, 6653)
		-- bob cannot release alice's lock while it is live
		t.falsy((HR.releaseRaid(r, "srvB", "bob", nil, 10, 1004)))
		t.truthy((HR.releaseRaid(r, "srvA", "alice", { t = 1004, raider = "alice", raiderName = "Alice", crewNames = {}, entry = "breaker", defences = {}, lost = 6653, retained = 0 }, 10, 1004)))
		t.eq(r.raid, nil); t.eq(r.unread, 1); t.eq(#r.reports, 1)
		local ok3, err3 = HR.claimRaid(r, "srvB", "bob", "Bob", 1100, 420, 600); t.falsy(ok3); t.truthy(err3:find("recently"))
		t.truthy((HR.claimRaid(r, "srvB", "bob", "Bob", 1700, 420, 600)))
		-- expired lock can be taken over by anyone
		t.truthy((HR.claimRaid(r, "srvC", "carol", "Carol", 1700 + 421, 420, 0)))
		t.eq(r.raid.raider, "carol")
		t.truthy((HR.releaseRaid(r, "srvZ", "zed", nil, 10, 1700 + 421 + 500)), "expired lock releasable by anyone")
	end)
	t.test("owner name is stored and migrated", function()
		local r = HR.default(); HR.setName(r, "Zed")
		t.eq(HR.migrate(r).ownerName, "Zed"); t.eq(HR.migrate({ ownerName = 5 }).ownerName, nil)
	end)

	t.test("retain adds back and reports are capped", function()
		local r = HR.default()
		t.truthy((HR.retain(r, 300))); t.eq(r.stash, 300); t.falsy((HR.retain(r, 0)))
		for i = 1, 12 do
			HR.claimRaid(r, "s", "a", "A", i * 1000, 10, 0)
			HR.releaseRaid(r, "s", "a", { t = i, raider = "a", raiderName = "A", crewNames = {}, entry = "x", defences = {}, lost = 0, retained = 0 }, 10, i * 1000 + 1)
		end
		t.eq(#r.reports, 10); t.eq(r.reports[1].t, 12); t.eq(r.unread, 12)
		HR.markRead(r); t.eq(r.unread, 0)
	end)
end
