local RareCarCycle = require("../src/shared/Core/RareCarCycle")

return function(t)
	local WEEK = 7 * 24 * 3600
	local cfg = { weekAnchorUnix = 0, weekSeconds = WEEK, breakInSeconds = 120 }

	t.test("heist once per week, transfer by break-in, steal back, no reopen", function()
		local C = RareCarCycle.new(cfg, 1000)
		t.truthy(C:heistAvailable())
		t.truthy(C:completeHeist("alice"))
		t.falsy((C:completeHeist("bob")), "heist is closed for the week")
		t.truthy(C:store("alice")); t.eq(C.location, "Stored")
		t.falsy((C:beginBreakIn("alice", 2000)), "owner cannot break into own car")
		t.truthy(C:beginBreakIn("bob", 2000))
		t.falsy((C:store("alice")), "owner cannot store during a break-in")
		t.near(C:breakInProgress(2060), 0.5)
		t.falsy((C:tryCompleteBreakIn(2119)))
		local done, previous = C:tryCompleteBreakIn(2120)
		t.truthy(done); t.eq(previous, "alice"); t.eq(C.owner, "bob")
		t.falsy(C:heistAvailable(), "a transfer never reopens the heist")
		t.truthy(C:beginBreakIn("alice", 3000))
		t.truthy((C:tryCompleteBreakIn(3120))); t.eq(C.owner, "alice")
	end)

	t.test("interruption cancels progress; a new attempt starts at zero", function()
		local C = RareCarCycle.new(cfg, 0)
		C:completeHeist("alice")
		C:beginBreakIn("bob", 100)
		t.truthy(C:interruptBreakIn("thief left range"))
		t.falsy(C:interruptBreakIn("again"))
		t.eq(C:breakInProgress(300), 0)
		t.truthy(C:beginBreakIn("bob", 300))
		t.falsy((C:tryCompleteBreakIn(320)))
		t.truthy((C:tryCompleteBreakIn(420)))
	end)

	t.test("weekly reset returns the car, reopens the heist, cancels a break-in", function()
		local C = RareCarCycle.new(cfg, 10)
		C:completeHeist("alice"); C:store("alice"); C:beginBreakIn("bob", 20)
		t.falsy(C:step(WEEK - 1))
		t.truthy(C:step(WEEK + 1))
		t.eq(C.owner, nil); t.eq(C.location, "HeistSite"); t.truthy(C:heistAvailable()); t.falsy(C.breakIn)
		t.eq(RareCarCycle.secondsUntilReset(cfg, WEEK + 1), WEEK - 1)
	end)
end
