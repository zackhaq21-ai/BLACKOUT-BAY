local B = require("../src/shared/Core/BountyRecord")

return function(t)
	t.test("contributions stack and pay once", function()
		local b = B.place(nil, "a", "target", 2000000, 0, 100)
		b = B.place(b, "b", "target", 2000000, 1, 100)
		t.eq(B.total(b), 4000000)
		local after, payout, err = B.claim(b, "hunter", "target", false, 10, 300)
		t.eq(payout, 4000000); t.falsy(err); t.eq(B.total(after), 0)
		local _, payout2, err2 = B.claim(after, "hunter", "target", false, 11, 300)
		t.eq(payout2, 0); t.eq(err2, "no bounty")
	end)

	t.test("invalid claims: self, contributor, crewmate, cooldown farming", function()
		local b = B.place(nil, "a", "target", 500, 0, 100)
		local _, p1, e1 = B.claim(b, "target", "target", false, 1, 300); t.eq(p1, 0); t.truthy(e1)
		local _, p2 = B.claim(b, "a", "target", false, 1, 300); t.eq(p2, 0)
		local _, p3 = B.claim(b, "mate", "target", true, 1, 300); t.eq(p3, 0)
		local after, p4 = B.claim(b, "hunter", "target", false, 1, 300); t.eq(p4, 500)
		after = B.place(after, "a", "target", 500, 2, 100)
		local _, p5, e5 = B.claim(after, "hunter2", "target", false, 100, 300); t.eq(p5, 0); t.eq(e5, "target was claimed recently")
		local _, p6 = B.claim(after, "hunter2", "target", false, 302, 300); t.eq(p6, 500)
	end)

	t.test("validation and refunds", function()
		t.falsy((B.place(nil, "a", "a", 500, 0, 100)))
		t.falsy((B.place(nil, "a", "b", 50, 0, 100)))
		t.falsy((B.place(nil, "a", "b", 100.5, 0, 100)))
		local b = B.place(nil, "a", "b", 300, 0, 100); b = B.place(b, "c", "b", 200, 0, 100)
		local after, refunds = B.refund(b)
		t.eq(refunds.a, 300); t.eq(refunds.c, 200); t.eq(B.total(after), 0)
		local _, none = B.refund(nil); t.eq(next(none), nil)
	end)
end
