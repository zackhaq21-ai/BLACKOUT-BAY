local BountyPool = require("../src/shared/Core/BountyPool")

return function(t)
	local cfg = { minContribution = 100, claimCooldownSeconds = 300 }

	t.test("contributions stack and pay once", function()
		local B = BountyPool.new(cfg)
		t.truthy(B:place("a", "target", 2000000, 0))
		t.truthy(B:place("b", "target", 2000000, 1))
		t.eq(B:totalOn("target"), 4000000)
		local ok, _, payout = B:claim("hunter", "target", false, 10)
		t.truthy(ok); t.eq(payout, 4000000)
		local ok2, err2, payout2 = B:claim("hunter", "target", false, 11)
		t.falsy(ok2); t.eq(payout2, 0); t.eq(err2, "no bounty")
		t.eq(B.claimsPaid, 1)
	end)

	t.test("invalid claims: self, contributor, crewmate, cooldown farming", function()
		local B = BountyPool.new(cfg)
		B:place("a", "target", 500, 0)
		t.falsy((B:claim("target", "target", false, 1)))
		t.falsy((B:claim("a", "target", false, 1)))
		t.falsy((B:claim("mate", "target", true, 1)))
		t.truthy((B:claim("hunter", "target", false, 1)))
		B:place("a", "target", 500, 2)
		local ok, err = B:claim("hunter2", "target", false, 100)
		t.falsy(ok); t.eq(err, "target claimed recently")
		t.truthy((B:claim("hunter2", "target", false, 302)))
	end)

	t.test("validation and refunds", function()
		local B = BountyPool.new(cfg)
		t.falsy((B:place("a", "a", 500, 0)))
		t.falsy((B:place("a", "b", 50, 0)))
		t.falsy((B:place("a", "b", 100.5, 0)))
		B:place("a", "b", 300, 0); B:place("c", "b", 200, 0)
		local refunds = B:refund("b")
		t.eq(refunds.a, 300); t.eq(refunds.c, 200); t.eq(B:totalOn("b"), 0)
		t.eq(#B:wanted(), 0)
	end)
end
