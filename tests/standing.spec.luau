local S = require("../src/shared/Core/Standing")
local Config = require("../src/shared/Config")
local cfg = Config.Progression

return function(t)
	t.test("ranks are ascending and resolve by xp", function()
		for i = 2, #cfg.Ranks do t.truthy(cfg.Ranks[i].xp > cfg.Ranks[i - 1].xp, "ranks ascending") end
		t.eq(S.rankFor(cfg, 0).id, "drifter")
		t.eq(S.rankFor(cfg, 199).id, "drifter")
		t.eq(S.rankFor(cfg, 200).id, "runner")
		t.eq(S.rankFor(cfg, 1e9).id, "legend")
		t.eq(S.rankFor(cfg, -5).id, "drifter")
		t.eq(S.rankFor(cfg, 0 / 0).id, "drifter")
		t.eq(S.nextRank(cfg, 0).id, "runner")
		t.eq(S.nextRank(cfg, 4000), nil)
	end)
	t.test("unlocks follow ranks; unknown keys never lock", function()
		t.falsy(S.unlocked(cfg, 0, "fakes"))
		t.truthy(S.unlocked(cfg, 200, "fakes"))
		t.falsy(S.unlocked(cfg, 200, "bounties"))
		t.truthy(S.unlocked(cfg, 600, "bounties"))
		t.truthy(S.unlocked(cfg, 0, "somethingNew"))
		t.truthy(S.lockReason(cfg, 50, "raids"):find("Runner"))
		t.eq(S.lockReason(cfg, 200, "raids"), nil)
		for key, rank in pairs(cfg.Unlocks) do t.truthy(S.rankIndex(cfg, rank) >= 1 and cfg.UnlockLabels[key], key) end
		t.eq(S.unlocksAt(cfg, "operator")[1], "bounties")
	end)
	t.test("awards: crew bonus and daily diminishing, NaN-safe, never negative", function()
		t.eq(S.crewFactor(cfg, 1), 1)
		t.eq(S.crewFactor(cfg, 3), 1.2)
		t.eq(S.crewFactor(cfg, 0 / 0), 1)
		t.eq(S.diminish(cfg, "raid", 0), 1)
		t.eq(S.diminish(cfg, "raid", 1), 1)
		t.eq(S.diminish(cfg, "raid", 2), 0.5, "third raid of the day is halved")
		t.eq(S.diminish(cfg, "recovery", 99), 1, "recovery never diminishes (it is your own money)")
		t.eq(S.diminish(cfg, "unknown", 50), 1)
		t.eq(S.award(cfg, "raid", S.baseAward(cfg, "raid"), 1, 0), 80)
		t.eq(S.award(cfg, "raid", 80, 5, 0), 112)
		t.eq(S.award(cfg, "raid", 80, 1, 5), 40)
		t.eq(S.award(cfg, "raid", -80, 1, 0), 0)
		t.eq(S.award(cfg, "raid", 0 / 0, 1, 0), 0)
		t.eq(S.baseAward(cfg, "nope"), 0)
	end)
	t.test("day key and onboarding skip", function()
		t.eq(S.dayKey(0), "1970-01-01")
		t.eq(S.dayKey(86400 * 2 + 5), "1970-01-03")
		t.truthy(S.skipsOnboarding(cfg, 1))
		t.falsy(S.skipsOnboarding(cfg, 0))
	end)
end
