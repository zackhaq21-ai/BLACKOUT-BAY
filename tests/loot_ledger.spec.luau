local LootLedger = require("../src/shared/Core/LootLedger")

return function(t)
	local function fresh()
		local clock = 0
		local L = LootLedger.new(function() return clock end)
		L:register({ id = "core", kind = "Core", label = "Aurora Core", value = 7500, weight = "Heavy", origin = "Aurora" })
		L:register({ id = "jewel", kind = "Jewel", label = "Aurora Jewel", value = 1800, weight = "Light" })
		return L
	end

	t.test("register rejects duplicate ids", function()
		local L = fresh()
		local ok, err = L:register({ id = "core", kind = "Core", label = "x", value = 1, weight = "Light" })
		t.falsy(ok); t.eq(err, "duplicate id")
	end)

	t.test("pick up, drop, pick up by another player (theft) keeps one identity", function()
		local L = fresh()
		t.truthy(L:pickUp("jewel", "alice", 1))
		t.eq(L:get("jewel").state, "Carried"); t.eq(L:get("jewel").holder, "alice")
		t.falsy((L:pickUp("jewel", "bob", 1)), "bob cannot take from alice's hands")
		t.truthy(L:drop("jewel", "alice", "plaza"))
		t.truthy(L:pickUp("jewel", "bob", 1))
		t.eq(L:get("jewel").holder, "bob")
		t.eq(#L:history("jewel"), 3)
		t.eq(L:countInState("Carried"), 1)
	end)

	t.test("hands full is enforced", function()
		local L = fresh()
		t.truthy(L:pickUp("jewel", "alice", 1))
		local ok, err = L:pickUp("core", "alice", 1)
		t.falsy(ok); t.eq(err, "hands full")
		t.truthy((L:pickUp("core", "alice", 2)))
	end)

	t.test("deliver credits value exactly once", function()
		local L = fresh()
		L:pickUp("jewel", "alice", 1)
		local ok, _, value = L:deliver("jewel", "alice", "job1")
		t.truthy(ok); t.eq(value, 1800)
		local ok2, err2, value2 = L:deliver("jewel", "alice", "job1")
		t.falsy(ok2); t.eq(value2, 0); t.truthy(err2)
		t.falsy((L:pickUp("jewel", "bob", 1)), "delivered items are gone")
	end)

	t.test("vehicle stow/take and spill on disable", function()
		local L = fresh()
		L:pickUp("jewel", "alice", 1); L:pickUp("core", "bob", 1)
		t.truthy(L:stow("jewel", "alice", "kestrel1", 2))
		t.truthy(L:stow("core", "bob", "kestrel1", 2))
		t.eq(#L:inVehicle("kestrel1"), 2)
		t.falsy((L:stow("jewel", "alice", "kestrel1", 2)), "already stowed")
		t.truthy(L:takeFromVehicle("jewel", "carol", "kestrel1", 1), "anyone can raid an open trunk")
		t.eq(L:get("jewel").holder, "carol")
		local spilled = L:dropAllFromVehicle("kestrel1", "seawall", "vehicle disabled")
		t.eq(#spilled, 1); t.eq(L:get("core").state, "Dropped")
		t.falsy((L:stow("jewel", "carol", "van", 0)), "trunk capacity 0")
	end)

	t.test("dropAllFromPlayer on arrest and destroy/purge", function()
		local L = fresh()
		L:pickUp("core", "alice", 1)
		local dropped = L:dropAllFromPlayer("alice", "lantern", "arrested")
		t.eq(#dropped, 1); t.eq(L:get("core").state, "Dropped")
		t.truthy(L:destroy("core", "restock"))
		t.falsy(L:destroy("core"), "already destroyed")
		t.eq(L:purgeTerminal(), 1)
		t.falsy(L:get("core"))
	end)
end
