local R = require("../src/shared/Core/ConvoyRules")
local W = require("../src/shared/Core/WorldEventRules")
local Config = require("../src/shared/Config")
local cfg = Config.WorldEvents.Convoy -- authoritative source
local routes = {
	{ name = "A", waypoints = { { x = 0, z = 0 }, { x = 500, z = 0 } }, checkpoints = { 2 } },
	{ name = "B", waypoints = { { x = 1000, z = 0 }, { x = 1000, z = 500 } }, checkpoints = { 2 } },
	{ name = "C", waypoints = { { x = 0, z = 1000 }, { x = 500, z = 1000 } }, checkpoints = { 2 } },
}
local function actor(over)
	local a = { alive = true, jailed = false, seated = false, distance = 3 }
	for k, v in pairs(over or {}) do a[k] = v end
	return a
end

return function(t)
	t.test("event lifecycle through WorldEventRules: bounded, one at a time, cooldown from either end", function()
		local def = R.definition(cfg)
		t.eq(def.id, "convoy"); t.eq(def.duration, 420); t.eq(def.cooldown, 900)
		local rules = W.new({ def })
		t.truthy((rules:start("convoy", 0)))
		t.falsy((rules:start("convoy", 10)), "duplicate convoy")
		t.truthy(rules:stop("convoy", 100)) -- delivered early
		t.falsy((rules:start("convoy", 500)), "cooldown")
		t.truthy((rules:start("convoy", 1000)))
		t.eq(#rules:step(1420), 1)
		local silly = R.definition({ MaxDurationSeconds = 5, CooldownSeconds = 1 })
		t.eq(silly.duration, 120); t.eq(silly.cooldown, 120)
	end)
	t.test("cargo values are server-owned and validated", function()
		local v = R.cargoValues(cfg); t.eq(#v, 3); t.eq(v[1] + v[2] + v[3], 6000)
		t.falsy((R.cargoValues({ CargoValues = {} })))
		t.falsy((R.cargoValues({ CargoValues = { 100, -5 } })))
		t.falsy((R.cargoValues({ CargoValues = { 0 / 0 } })))
		t.falsy((R.cargoValues({ CargoValues = { math.huge } })))
		t.falsy((R.cargoValues({ CargoValues = { "2000" } })))
		t.falsy((R.cargoValues({ CargoValues = { 1, 1, 1, 1, 1, 1 } })))
		t.falsy((R.cargoValues({ CargoValues = { 20000, 20000 } })), "economy bound")
		t.eq(R.cargoValues({ CargoValues = { 1999.9 } })[1], 1999)
	end)
	t.test("route selection avoids the last route and player-adjacent starts; tolerates malformed players", function()
		local first = function() return 1 end
		t.eq(R.pickRoute(routes, nil, {}, 90, first), 1)
		t.eq(R.pickRoute(routes, 1, {}, 90, first), 2, "never the last route")
		t.eq(R.pickRoute(routes, 1, { { x = 1010, z = 20 } }, 90, first), 3, "player near B's start")
		t.eq(R.pickRoute(routes, 1, { { x = 1010, z = 20 }, { x = 10, z = 1000 } }, 90, first), 2, "all blocked: fall back to any non-last route")
		t.eq(R.pickRoute(routes, 1, { "junk", { x = "a" }, {} }, 90, first), 2)
		t.eq(R.pickRoute({ routes[1] }, 1, {}, 90, first), 1, "a single route repeats")
		t.falsy(R.pickRoute({}, nil, {}, 90, first))
		t.eq(R.pickRoute(routes, nil, {}, 90, function() return 99 end), 3, "pick index clamped")
		t.eq(R.routeLength(routes[1]), 500)
	end)
	t.test("breach eligibility and the blackout factor", function()
		local cargo = R.newCargo()
		t.eq(R.breachRefusal(cfg, cargo, actor(), 0, 100), nil)
		t.eq(R.breachRefusal(cfg, cargo, actor(), 5, 100), "the transport is moving")
		t.eq(R.breachRefusal(cfg, cargo, actor({ seated = true }), 0, 100), "on foot only")
		t.eq(R.breachRefusal(cfg, cargo, actor({ jailed = true }), 0, 100), "jailed")
		t.eq(R.breachRefusal(cfg, cargo, actor({ alive = false }), 0, 100), "not alive")
		t.eq(R.breachRefusal(cfg, cargo, actor({ distance = 12 }), 0, 100), "too far from the doors")
		R.sealDoors(cfg, cargo, 100)
		t.truthy(R.breachRefusal(cfg, cargo, actor(), 0, 110):find("sealed"))
		t.eq(R.breachRefusal(cfg, cargo, actor(), 0, 120), nil)
		t.eq(R.breachSeconds(cfg, false), 10)
		t.eq(R.breachSeconds(cfg, true), 6)
		t.eq(R.breachSeconds({ BreachSeconds = 10, BlackoutBreachFactor = 0 / 0 }, true), 10)
		t.eq(R.breachSeconds({ BreachSeconds = 10, BlackoutBreachFactor = 0.01 }, true), 3, "never trivial")
	end)
	t.test("cargo is claimed exactly once, also under a simultaneous second claimant", function()
		local cargo = R.newCargo()
		t.truthy(R.claimCargo(cargo, "alice", 50))
		t.falsy(R.claimCargo(cargo, "bob", 50), "same tick")
		t.falsy(R.claimCargo(cargo, "alice", 60), "retry / rejoin")
		t.eq(cargo.by, "alice"); t.eq(cargo.state, "minted")
		R.sealDoors(cfg, cargo, 70)
		t.eq(cargo.lockedUntil, 0, "sealing is meaningless after the take")
		t.eq(R.breachRefusal(cfg, cargo, actor(), 0, 80), "cargo already taken")
	end)
	t.test("escalation only rises; speeds and checkpoint halts follow it", function()
		local a = R.newAlert(0)
		t.falsy(R.escalate(a, "nonsense", 1)); t.eq(a.level, 0)
		t.truthy(R.escalate(a, "seen", 1)); t.eq(a.level, 1)
		t.eq(R.cruiseSpeed(cfg, a, false), 26 * 1.3)
		t.truthy(R.haltsAtCheckpoints(a))
		t.truthy(R.escalate(a, "ram", 2)); t.eq(a.level, 2)
		t.falsy(R.escalate(a, "seen", 3), "no de-escalation"); t.eq(a.level, 2)
		t.falsy(R.haltsAtCheckpoints(a))
		t.truthy(R.escalate(a, "crippled", 4)); t.eq(a.level, 3)
		t.eq(R.cruiseSpeed(cfg, a, true), 0)
		t.eq(R.cruiseSpeed({ CruiseSpeed = 26, AlertSpeedFactor = 9 }, a, false), 52, "speed factor clamped")
	end)
	t.test("formation and abandonment", function()
		t.eq(R.followFactor(5, 22), 0); t.eq(R.followFactor(18, 22), 0.6); t.eq(R.followFactor(22, 22), 1); t.eq(R.followFactor(60, 22), 1.35)
		t.falsy(R.abandoned(cfg, 0, 149)); t.truthy(R.abandoned(cfg, 0, 150))
		t.truthy(R.abandoned({ AbandonSeconds = 1 }, 0, 30), "window clamped to a sane minimum")
	end)
	t.test("storm variant: only in a storm, by chance, one heavy sealed crate on the Seawall route", function()
		local storm = Config.WorldEvents.Convoy.Storm
		t.eq(R.pickVariant(storm, "Clear", 0), "standard")
		t.eq(R.pickVariant(storm, "Storm", 0), "storm")
		t.eq(R.pickVariant(storm, "Storm", 0.99), "standard")
		t.eq(R.pickVariant(storm, "Storm", 0 / 0), "standard", "NaN roll never forces the rare variant")
		t.eq(R.pickVariant(nil, "Storm", 0), "standard")
		local values, weight, err = R.cargoFor(cfg, storm, "storm")
		t.eq(err, nil); t.eq(#values, 1); t.eq(values[1], storm.CargoValue); t.eq(weight, "Heavy")
		local std, w2 = R.cargoFor(cfg, storm, "standard")
		t.eq(#std, #cfg.CargoValues); t.eq(w2, "Light")
		t.falsy((R.cargoFor(cfg, { Chance = 1, RouteName = "x", CargoValue = -5, CargoLabel = "x" }, "storm")))
		local Blueprint = require("../src/shared/MapBlueprint")
		t.truthy(R.routeIndexByName(Blueprint.ConvoyRoutes, storm.RouteName), "storm route exists")
		t.eq(R.routeIndexByName(Blueprint.ConvoyRoutes, "nope"), nil)
	end)

	t.test("public state leaks nothing server-only", function()
		local cargo = R.newCargo()
		local p = R.publicState("Moving", cargo, R.newAlert(0), 0)
		t.eq(p.cargo, "secured"); t.eq(p.crates, 0)
		for k in pairs(p) do t.truthy(k == "phase" or k == "cargo" or k == "crates" or k == "alert", "unexpected field " .. k) end
		R.claimCargo(cargo, "x", 1); cargo.crates = { "Bundle_1", "Bundle_2", "Bundle_3" }
		t.eq(R.publicState("Breached", cargo, R.newAlert(0), 2).cargo, "loose")
		t.eq(R.publicState("Breached", cargo, R.newAlert(0), 0).cargo, "taken")
		t.eq(R.publicState("Breached", cargo, R.newAlert(0), 0).crates, 3)
		local sealed = R.newCargo(); local a = R.newAlert(0); R.escalate(a, "crippled", 1)
		t.eq(R.publicState("Halted", sealed, a, 0).cargo, "sealed")
	end)
end
