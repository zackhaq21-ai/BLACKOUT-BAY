local V = require("../src/shared/Core/VehicleFeel")
local Config = require("../src/shared/Config")
local cfg = Config.Presentation.Vehicle
local car, truck, cop = Config.Vehicles.Kestrel, Config.Vehicles.Armored, Config.Vehicles.Cruiser

return function(t)
	t.test("drive modes: brake before reverse, coast on no throttle", function()
		t.eq(V.mode(cfg, 0, 30), "coast")
		t.eq(V.mode(cfg, 1, 0), "drive")
		t.eq(V.mode(cfg, -1, 30), "brake")
		t.eq(V.mode(cfg, -1, 2), "reverse")
		t.eq(V.mode(cfg, 1, -30), "brake")
		t.eq(V.mode(cfg, 0 / 0, 0 / 0), "coast")
	end)
	t.test("torque curve pulls away strongly and fades at speed, never negative", function()
		t.eq(V.torqueFactor(cfg, car, 0), cfg.LowSpeedTorqueBoost)
		t.eq(V.torqueFactor(cfg, car, car.maxSpeed), cfg.HighSpeedTorqueFade)
		t.truthy(V.torqueFactor(cfg, car, 999) > 0)
		t.eq(V.targetSpeed(cfg, car, 1, "drive"), car.maxSpeed)
		t.eq(V.targetSpeed(cfg, car, -1, "reverse"), -car.maxSpeed * cfg.ReverseFraction)
		t.eq(V.targetSpeed(cfg, car, -1, "brake"), 0)
	end)
	t.test("classes differ: the armored transport is slower-handed than a car or cruiser", function()
		t.truthy(V.isHeavy(cfg, truck) and not V.isHeavy(cfg, car) and not V.isHeavy(cfg, cop))
		t.truthy(V.steerSpeed(cfg, truck, 0) < V.steerSpeed(cfg, car, 0))
		t.truthy(V.steerSpeed(cfg, car, car.maxSpeed) < V.steerSpeed(cfg, car, 0), "slower hands at speed")
		t.eq(V.steerLock(cfg, car, 0), 1)
		t.eq(V.steerLock(cfg, car, car.maxSpeed), cfg.SteerLockMin)
		t.truthy(V.steerLock(cfg, truck, truck.maxSpeed) < V.steerLock(cfg, car, car.maxSpeed))
		t.truthy(V.steerLock(cfg, truck, 1e9) >= 0.2)
	end)
	t.test("brake lights show on braking and lift-off at speed only", function()
		t.truthy(V.brakeLights(cfg, -1, 30))
		t.truthy(V.brakeLights(cfg, 0, 30))
		t.falsy(V.brakeLights(cfg, 0, 3))
		t.falsy(V.brakeLights(cfg, 1, 30))
	end)
end
