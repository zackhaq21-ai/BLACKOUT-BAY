local MissionFlow = require("../src/shared/Core/MissionFlow")

return function(t)
	local function fresh(members)
		local clock = { t = 0 }
		local m = MissionFlow.new("job1", "crew1", members or { "a", "b" }, function() return clock.t end)
		return m, clock
	end

	t.test("phases advance monotonically", function()
		local m = fresh()
		t.eq(m:phase(), "Started")
		m:memberEnteredSite("a"); t.eq(m:phase(), "OnSite")
		m:lootPicked("a", "jewel", "Jewel"); t.eq(m:phase(), "LootTaken")
		m:memberEnteredSite("b"); t.eq(m:phase(), "LootTaken", "cannot go backwards")
		m:lootLeftSite("a", "Jewel"); t.eq(m:phase(), "Escaping")
	end)

	t.test("delivery credits once and summary reads clean", function()
		local m = fresh()
		m:lootPicked("a", "jewel", "Jewel")
		m:lootDelivered("a", "jewel", "Jewel", 1800)
		m:lootDelivered("a", "jewel", "Jewel", 1800)
		t.eq(m.job.deliveredValue, 1800)
		local close, reason = m:shouldAutoClose(0, 900)
		t.truthy(close); t.eq(reason, "Haul delivered")
		m:close(reason)
		t.eq(m:summary().headline, "Clean job")
	end)

	t.test("escalation is remembered and summary says loud", function()
		local m = fresh()
		m:securityChanged(1, "Guard noticed something")
		m:securityChanged(2, "Spotted by Gallery Guard")
		m:securityChanged(3, "Lockdown")
		t.eq(m.job.escalation, "Spotted by Gallery Guard")
		m:lootPicked("b", "core", "Core"); m:lootDelivered("b", "core", "Core", 7500)
		m:close("Haul delivered")
		t.eq(m:summary().headline, "Loud, but paid")
	end)

	t.test("member leaving forfeits presence; disband auto-closes", function()
		local m = fresh()
		m:memberLeft("a", { "Jewel" })
		t.eq(#m:presentMembers(), 1)
		t.eq(m.job.log[#m.job.log].text, "a left the crew carrying Jewel")
		m:memberLeft("b", {})
		local close, reason = m:shouldAutoClose(1, 900)
		t.truthy(close); t.eq(reason, "Crew disbanded")
	end)

	t.test("all present arrested closes as busted", function()
		local m = fresh()
		m:memberArrested("a", { "Core" }, "Lantern Cross")
		t.falsy((m:shouldAutoClose(1, 900)))
		m:memberArrested("b", {})
		local close, reason = m:shouldAutoClose(1, 900)
		t.truthy(close); t.eq(reason, "Crew arrested")
		m:close(reason); t.eq(m:summary().headline, "Busted")
		m:memberReleased("a")
		t.eq(m:isActive(), false)
	end)

	t.test("job window expiry and haul lost", function()
		local m, clock = fresh()
		m:lootPicked("a", "jewel", "Jewel")
		t.falsy((m:shouldAutoClose(1, 900)))
		clock.t = 901
		local close, reason = m:shouldAutoClose(1, 900)
		t.truthy(close); t.eq(reason, "Job window expired")
		local m2 = fresh()
		m2:lootPicked("a", "jewel", "Jewel")
		local c2, r2 = m2:shouldAutoClose(0, 900)
		t.truthy(c2); t.eq(r2, "Haul lost")
		m2:close(r2); t.eq(m2:summary().headline, "Walked away empty")
	end)

	t.test("minted bundles count as loot taken", function()
		local m = fresh()
		m:memberEnteredSite("a")
		m:lootMinted({ "b1", "b2" }, "Stash Bundle")
		t.eq(m:phase(), "LootTaken"); t.truthy(m.job.touched.b1); t.truthy(m.job.touched.b2)
		t.truthy((m:shouldAutoClose(0, 900)))
	end)

	t.test("log is bounded", function()
		local m = fresh()
		for i = 1, 100 do m:lootDropped("a", "x" .. i, "X", nil) end
		t.eq(#m.job.log, 60)
	end)
end
