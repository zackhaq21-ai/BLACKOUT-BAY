local R = require("../src/shared/Core/CrewRecord")
local Config = require("../src/shared/Config")
local cfg = Config.Crews

return function(t)
	t.test("default, validate and rename with cooldown", function()
		local r = R.default(42, "Zack", 1000)
		t.eq(r.name, "Zack's crew"); t.eq(r.members["42"], "Zack")
		t.eq(R.validateName(cfg, "  Night   Tide  "), "Night Tide")
		t.falsy((R.validateName(cfg, "ab")))
		t.falsy((R.validateName(cfg, string.rep("a", 21))))
		t.falsy((R.validateName(cfg, "bad\1name")))
		t.eq(R.validateName(cfg, "two\nlines"), "two lines", "newlines collapse to spaces")
		t.falsy((R.validateName(cfg, "!!!")))
		t.falsy((R.validateName(cfg, 123)))
		local ok = R.rename(r, "Night Tide", 2000, cfg); t.truthy(ok); t.eq(r.name, "Night Tide")
		local again, err = R.rename(r, "Other", 2100, cfg); t.falsy(again); t.truthy(err:find("rename again"))
		t.truthy((R.rename(r, "Other", 2000 + cfg.RenameCooldownSeconds, cfg)))
		local same, err2 = R.rename(r, "Other", 9999, cfg); t.falsy(same); t.truthy(err2)
	end)
	t.test("members are bounded; history is a bounded FIFO; bests only rise; milestones once", function()
		local r = R.default(1, "A", 0)
		for i = 2, cfg.MaxMembers + 5 do
			R.touchMember(r, i, "P" .. i, cfg)
		end
		local n = 0
		for _ in pairs(r.members) do n += 1 end
		t.eq(n, cfg.MaxMembers)
		for i = 1, cfg.MaxHistory + 3 do
			R.note(r, "job", i * 100, "job " .. i, i, cfg)
		end
		t.eq(#r.history, cfg.MaxHistory)
		t.eq(r.history[1].text, "job 4")
		t.eq(r.totals.jobs, cfg.MaxHistory + 3)
		t.eq(r.bests.biggestJob, (cfg.MaxHistory + 3) * 100)
		R.note(r, "job", 5, "small", 99, cfg)
		t.eq(r.bests.biggestJob, (cfg.MaxHistory + 3) * 100)
		R.note(r, "raid", 0 / 0, "nan raid", 100, cfg)
		t.eq(r.bests.biggestRaid, 0); t.eq(r.totals.raids, 1)
		local _, first = R.milestone(r, "glass_ghost", 1, cfg)
		local _, second = R.milestone(r, "glass_ghost", 2, cfg)
		t.truthy(first); t.falsy(second)
	end)
	t.test("migration validates every field and never trusts an unfiltered name", function()
		local raw = { name = "Unfiltered Name", filtered = false, createdAt = "x", members = { ["7"] = "Bob", bad = "x", ["8"] = 5 }, totals = { jobs = -3, delivered = 1e15, raids = 2.7 }, bests = { biggestRaid = 0 / 0 }, history = { { t = 1, kind = "job", text = "ok", value = 3 }, "junk", { t = "no" } }, milestones = { a = 1, b = "x" } }
		local r = R.migrate(raw, 42, "Zack", 500, cfg)
		t.eq(r.name, "Zack's crew", "unfiltered name discarded")
		t.eq(r.createdAt, 500)
		t.eq(r.members["7"], "Bob"); t.eq(r.members["8"], nil); t.eq(r.members.bad, nil); t.eq(r.members["42"], "Zack")
		t.eq(r.totals.jobs, 0); t.eq(r.totals.delivered, 0); t.eq(r.totals.raids, 2)
		t.eq(r.bests.biggestRaid, 0)
		t.eq(#r.history, 1)
		t.eq(r.milestones.a, 1); t.eq(r.milestones.b, nil)
		local good = R.migrate({ name = "Night Tide", filtered = true }, 42, "Zack", 500, cfg)
		t.eq(good.name, "Night Tide")
		t.eq(R.migrate(nil, 1, "A", 0, cfg).name, "A's crew")
	end)
	t.test("summary and ledger lines are bounded and client-safe", function()
		local r = R.default(1, "A", 0)
		R.note(r, "raid", 3000, "A cracked B's safe for 3000", 10, cfg)
		R.note(r, "bounty", 1200, "A collected 1200 on C", 20, cfg)
		for i = 1, 20 do R.note(r, "job", 100, "job " .. i, 30 + i, cfg) end
		local s = R.summary(r, 86400 * 3)
		t.eq(s.days, 3); t.eq(#s.recent, 5); t.eq(s.bests.highestBounty, 1200); t.eq(s.members[1], "A")
		local lines = R.ledgerLines(r, 86400 * 3, cfg)
		t.truthy(#lines <= cfg.LedgerLines and #lines >= 4)
		t.eq(lines[1], "A'S CREW")
	end)
end
