local R = require("../src/shared/Core/WorldEventRules")

return function(t)
	t.test("start, expiry, cooldown, early stop", function()
		local rules = R.new({ { id = "blackout", duration = 75, cooldown = 300 } })
		t.falsy((rules:start("nope", 0)))
		local a = rules:start("blackout", 10, "alice", { district = "all" })
		t.truthy(a); t.eq(a.endsAt, 85)
		local ok, err = rules:start("blackout", 20); t.falsy(ok); t.eq(err, "already active")
		t.eq(rules:secondsLeft("blackout", 40), 45)
		t.eq(#rules:step(84), 0)
		local ended = rules:step(85); t.eq(#ended, 1); t.eq(ended[1].startedBy, "alice")
		local ok2, err2 = rules:start("blackout", 100); t.falsy(ok2); t.truthy(err2:find("cooling"))
		t.truthy((rules:start("blackout", 385)))
		t.truthy(rules:stop("blackout", 390)); t.falsy(rules:stop("blackout", 391))
		t.falsy((rules:start("blackout", 400)), "cooldown counts from the early stop")
		t.truthy((rules:start("blackout", 690)))
	end)
end
